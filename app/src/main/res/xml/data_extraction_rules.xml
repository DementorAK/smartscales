<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Cloud backup is off: backups go to the user's own Google Drive from the app.
    Device-to-device transfer moves everything, V2 keys included, so a new phone works right away.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
